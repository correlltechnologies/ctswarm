# ctswarm configuration.
#
# bootstrap.sh copies this to .env and fills in what it can discover without
# prompting. It never overwrites an existing .env.
#
# Nothing here is required to run `ctswarm doctor` or `ctswarm bench`. The
# credentials below are required to run an actual build.

# --- Runtime selection -----------------------------------------------------
# Which SWE-AF runtime executes builds by default.
#   open_code    open models through the ctswarm router (local + openrouter)
#   claude_code  Claude subscription or API
#   codex        ChatGPT subscription or OpenAI API
# The capacity manager can override this per build based on remaining headroom.
SWE_DEFAULT_RUNTIME=open_code

# Virtual models resolved by the ctswarm router. These strings are valid both as
# opencode provider/model references and as ctswarm tier names, which is what
# lets one value satisfy both systems.
SWE_MODEL_HIGH=ctswarm/high
SWE_MODEL_MED=ctswarm/med
SWE_MODEL_LOW=ctswarm/low

# --- Claude subscription ---------------------------------------------------
# Uses Pro/Max credits rather than API billing. Get it with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=

# Alternative: Anthropic API billing.
ANTHROPIC_API_KEY=

# --- Codex / ChatGPT -------------------------------------------------------
# Run `codex login` on the host; ~/.codex is mounted into the agent containers.
#   auto     use OPENAI_API_KEY when set, otherwise the local Codex login
#   chatgpt  force the ChatGPT subscription login
#   api_key  force OpenAI API billing
SWE_CODEX_AUTH_MODE=auto
OPENAI_API_KEY=

# --- OpenRouter (optional overflow capacity) -------------------------------
# Free-tier limits are tight, so free models are opportunistic capacity rather
# than the foundation of a 24/7 factory. Prices are fetched live, never
# hardcoded. Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# --- Local inference -------------------------------------------------------
# Bind these to loopback or a private tailnet only. Never expose an inference
# port to the public internet.
CTSWARM_OLLAMA_HOST=http://localhost:11434
CTSWARM_MLX_HOST=http://localhost:8081
CTSWARM_LMSTUDIO_HOST=http://localhost:1234

# Prefer local models when scores are close. Set to 0 to route purely on score.
CTSWARM_PREFER_LOCAL=1

# An extra OpenAI-compatible endpoint, e.g. a second machine on the tailnet.
# Format: name|url
CTSWARM_EXTRA_BACKEND=
CTSWARM_EXTRA_BACKEND_KEY=

# --- GitHub ----------------------------------------------------------------
# Prefer a GitHub App installation token scoped to selected repositories over a
# broad personal token. Grant contents and pull-requests only. Never grant
# workflow or secrets administration: an agent must not be able to alter the
# rules that constrain it.
GH_TOKEN=

# --- Slack approvals (optional) --------------------------------------------
# Without these, the local approval UI on :8091 is used instead. See docs/SLACK.md.
# SLACK_SIGNING_SECRET is mandatory for the interactivity endpoint: it decides
# whether irreversible actions proceed.
SLACK_BOT_TOKEN=
SLACK_SIGNING_SECRET=
SLACK_APPROVAL_CHANNEL=

# --- Budget ----------------------------------------------------------------
# Hard ceiling on paid-model spend per build. Exceeding it requires approval.
CTSWARM_BUDGET_USD_PER_BUILD=2.00

# --- Always-on scheduler ---------------------------------------------------
# Builds are queued durably in the shared ledger. Keep this at 1 while builds
# share one GPU and one build-time database.
CTSWARM_MAX_CONCURRENT_BUILDS=1
CTSWARM_SCHEDULER_POLL_SECONDS=10
CTSWARM_SCHEDULER_URL=http://localhost:8092

# Docker json-file rotation applies to every service in the stack.
CTSWARM_LOG_MAX_SIZE=10m
CTSWARM_LOG_MAX_FILES=5

# --- Build-time test database ----------------------------------------------
DATABASE_URL_TEST=postgres://builder:builder@build-db:5432/buildtest
