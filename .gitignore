# Source planning document (not committed by request)
*.docx

# Secrets and local config.
#
# Broad on purpose. During setup a copied template landed as
# ".env copy.example", which the previous narrow rules did not match, so a live
# OAuth token sat one `git add -A` away from being committed. Ignore every .env
# variant and re-include only the template.
.env*
!.env.example
*.env
secrets/
*.pem
*.key

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node
node_modules/
dist/
build/
.vite/
coverage/

# Vendored upstream (fetched by bootstrap, pinned in infra/versions.env)
vendor/

# Runtime state
var/
*.db
*.sqlite
*.sqlite3
logs/
*.log

# Build artifacts and evidence bundles
evidence/out/
bench/results/*.json
!bench/results/.gitkeep
worktrees/

# Editor / OS
.DS_Store
.idea/
*.swp

# Obsidian
.obsidian/workspace*

# Local agent skills and compatibility links. Skills are installed per-machine;
# product context and project-owned agent instructions remain tracked elsewhere.
.agents/skills/impeccable/
.claude/skills/impeccable
skills-lock.json
