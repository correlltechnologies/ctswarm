# Pinned upstream versions.
#
# SWE-AF is public beta with no tagged release, so tracking `main` would mean the
# factory changes underneath a running pilot. Pin a commit that has been tested
# here, and move it deliberately.
#
# To move the pin: update SWE_AF_COMMIT, run `./bootstrap.sh --revendor`, then
# run `ctswarm verify` before trusting it with a real repository.

SWE_AF_REPO=https://github.com/Agent-Field/SWE-AF
SWE_AF_COMMIT=0235d11233e575493f83aabe475b4c997a6f989b
SWE_AF_COMMIT_DATE=2026-07-23

# AgentField Python SDK. SWE-AF's deployment guide requires >=0.1.67 for the
# opencode v1.4+ CLI compatibility fix (upstream issue #45): opencode moved the
# prompt to a positional arg and repurposed -c, which silently breaks the
# Product Manager step with the open runtime.
AGENTFIELD_MIN_VERSION=0.1.67

# Control plane image used by SWE-AF's own compose file.
AGENTFIELD_CONTROL_PLANE_IMAGE=agentfield/control-plane:latest

# Minimum ollama for the laguna-xs-2.1 catalog entry. Older releases refuse the
# pull with a download prompt rather than a version error.
OLLAMA_MIN_VERSION_FOR_LAGUNA=0.32.0
