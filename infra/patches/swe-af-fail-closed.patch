diff --git a/swe_af/execution/git_fast_path.py b/swe_af/execution/git_fast_path.py
index fb8be8f..c3825aa 100644
--- a/swe_af/execution/git_fast_path.py
+++ b/swe_af/execution/git_fast_path.py
@@ -22,6 +22,7 @@ All functions are synchronous; the executor wraps them in asyncio.to_thread.
 from __future__ import annotations
 
 import os
+import re
 import shutil
 import subprocess
 import time
@@ -51,6 +52,130 @@ def _identity_args(repo_path: str) -> list[str]:
     return ["-c", "user.name=SWE-AF", "-c", "user.email=swe-af@agentfield.local"]
 
 
+def _goal_slug(goal: str) -> str:
+    slug = re.sub(r"[^a-z0-9]+", "-", goal.lower()).strip("-")
+    return (slug[:40].rstrip("-") or "build")
+
+
+def _exclude_runtime_paths(repo_path: str) -> None:
+    """Keep pipeline state out of git without editing a tracked .gitignore."""
+    exclude_path = os.path.join(repo_path, ".git", "info", "exclude")
+    os.makedirs(os.path.dirname(exclude_path), exist_ok=True)
+    existing = ""
+    if os.path.exists(exclude_path):
+        with open(exclude_path, encoding="utf-8") as f:
+            existing = f.read()
+    additions = [
+        pattern
+        for pattern in (".artifacts/", ".worktrees/", ".agentfield_output.json")
+        if pattern not in existing.splitlines()
+    ]
+    if additions:
+        with open(exclude_path, "a", encoding="utf-8") as f:
+            if existing and not existing.endswith("\n"):
+                f.write("\n")
+            f.write("\n".join(additions) + "\n")
+
+
+def _remote_default_branch(repo_path: str) -> str:
+    symbolic = _git(
+        repo_path, "symbolic-ref", "--short", "refs/remotes/origin/HEAD",
+        check=False,
+    )
+    if symbolic.returncode != 0:
+        return ""
+    value = symbolic.stdout.strip()
+    return value.removeprefix("origin/")
+
+
+def validate_git_init(repo_path: str, result: dict) -> dict:
+    """Reject plausible-looking GitInitResult objects that do not match git."""
+    if not result.get("success"):
+        return result
+    if result.get("mode") not in {"fresh", "existing"}:
+        raise GitFastPathError(f"invalid git init mode: {result.get('mode')!r}")
+
+    required = ("integration_branch", "initial_commit_sha")
+    missing = [key for key in required if not str(result.get(key) or "").strip()]
+    if missing:
+        raise GitFastPathError(
+            f"git init reported success with empty fields: {', '.join(missing)}"
+        )
+
+    head = _git(repo_path, "rev-parse", "HEAD").stdout.strip()
+    branch = _git(repo_path, "branch", "--show-current").stdout.strip()
+    if head != result["initial_commit_sha"]:
+        raise GitFastPathError(
+            "git init initial_commit_sha does not match repository HEAD"
+        )
+    if branch != result["integration_branch"]:
+        raise GitFastPathError(
+            f"git init integration branch {result['integration_branch']!r} "
+            f"is not checked out (actual {branch!r})"
+        )
+    return result
+
+
+def initialize_repository(repo_path: str, goal: str, build_id: str = "") -> dict:
+    """Initialize the integration branch using plain git, without an LLM."""
+    os.makedirs(repo_path, exist_ok=True)
+    git_dir = _git(repo_path, "rev-parse", "--git-dir", check=False)
+    mode = "existing" if git_dir.returncode == 0 else "fresh"
+
+    if mode == "fresh":
+        _git(repo_path, "init")
+        _git(repo_path, "checkout", "-B", "main")
+        _exclude_runtime_paths(repo_path)
+        _git(repo_path, "add", "-A")
+        _git(
+            repo_path, *_identity_args(repo_path), "commit",
+            "--allow-empty", "-m", "chore: initial commit",
+        )
+        original_branch = ""
+        integration_branch = "main"
+    else:
+        _exclude_runtime_paths(repo_path)
+        tracked_status = _git(
+            repo_path, "status", "--porcelain", "--untracked-files=no",
+        ).stdout.strip()
+        if tracked_status:
+            raise GitFastPathError(
+                "tracked working tree changes exist before git initialization"
+            )
+        original_branch = _git(repo_path, "branch", "--show-current").stdout.strip()
+        initial_commit = _git(repo_path, "rev-parse", "HEAD").stdout.strip()
+        core = f"{build_id}-{_goal_slug(goal)}" if build_id else _goal_slug(goal)
+        integration_branch = f"feature/{core}"
+        exists = _git(
+            repo_path, "rev-parse", "--verify", integration_branch, check=False,
+        ).returncode == 0
+        if exists:
+            _git(repo_path, "checkout", integration_branch)
+        else:
+            _git(repo_path, "checkout", "-b", integration_branch, initial_commit)
+
+    os.makedirs(os.path.join(repo_path, ".worktrees"), exist_ok=True)
+    initial_commit = _git(repo_path, "rev-parse", "HEAD").stdout.strip()
+    remote = _git(repo_path, "remote", "get-url", "origin", check=False)
+    remote_url = remote.stdout.strip() if remote.returncode == 0 else ""
+    repo_name = ""
+    if remote_url:
+        repo_name = remote_url.rstrip("/").rsplit("/", 1)[-1].removesuffix(".git")
+
+    result = {
+        "mode": mode,
+        "original_branch": original_branch,
+        "integration_branch": integration_branch,
+        "initial_commit_sha": initial_commit,
+        "success": True,
+        "error_message": "",
+        "remote_url": remote_url,
+        "remote_default_branch": _remote_default_branch(repo_path),
+        "repo_name": repo_name,
+    }
+    return validate_git_init(repo_path, result)
+
+
 def branch_core(issue: dict, build_id: str = "") -> str:
     """The shared naming core: ``[<build_id>-]<NN>-<name>``."""
     name = issue.get("name") or "issue"
