+def _repository_changed_files(
+    worktree_path: str,
+    integration_branch: str,
+) -> list[str] | None:
+    """Return git-observed changes, or None when the path is not a git repo."""
+    probe = subprocess.run(
+        ["git", "-C", worktree_path, "rev-parse", "--git-dir"],
+        capture_output=True,
+        text=True,
+    )
+    if probe.returncode != 0:
+        return None
+
+    changed: set[str] = set()
+    status = subprocess.run(
+        ["git", "-C", worktree_path, "status", "--porcelain"],
+        capture_output=True,
+        text=True,
+        check=True,
+    )
+    for line in status.stdout.splitlines():
+        path = line[3:].strip()
+        if " -> " in path:
+            path = path.split(" -> ", 1)[1]
+        if path and not path.startswith(".artifacts/"):
+            changed.add(path)
+
+    if integration_branch:
+        diff = subprocess.run(
+            [
+                "git", "-C", worktree_path, "diff", "--name-only",
+                f"{integration_branch}...HEAD",
+            ],
+            capture_output=True,
+            text=True,
+        )
+        if diff.returncode == 0:
+            changed.update(
+                path.strip()
+                for path in diff.stdout.splitlines()
+                if path.strip() and not path.startswith(".artifacts/")
+            )
+    return sorted(changed)
+
+
+def _issue_requires_repository_changes(issue: dict) -> bool:
+    return bool(issue.get("files_to_create") or issue.get("files_to_modify"))
+
+
