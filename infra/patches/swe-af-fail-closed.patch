+def _init_git_repo(path: Path) -> None:
+    subprocess.run(["git", "init", "-q"], cwd=path, check=True)
+    subprocess.run(["git", "checkout", "-q", "-b", "integration"], cwd=path, check=True)
+    subprocess.run(["git", "config", "user.email", "test@example.com"], cwd=path, check=True)
+    subprocess.run(["git", "config", "user.name", "Test"], cwd=path, check=True)
+    (path / "base.txt").write_text("base\n")
+    subprocess.run(["git", "add", "base.txt"], cwd=path, check=True)
+    subprocess.run(["git", "commit", "-q", "-m", "base"], cwd=path, check=True)
+
+
+def test_empty_coder_claim_is_rejected_before_review(tmp_path: Path) -> None:
+    _init_git_repo(tmp_path)
+    dag_state = _make_dag_state(tmp_path, build_id="emptygate1")
+    config = ExecutionConfig(max_coding_iterations=1)
+    issue = {
+        "name": "change-base",
+        "files_to_modify": ["base.txt"],
+        "integration_branch": "integration",
+    }
+    reviewer_called = False
+
+    async def call_fn(target: str, **kwargs):
+        nonlocal reviewer_called
+        if target.endswith(".run_coder"):
+            return {
+                "complete": True,
+                "files_changed": ["base.txt"],
+                "summary": "done",
+            }
+        if target.endswith(".run_code_reviewer"):
+            reviewer_called = True
+            return {"approved": True, "blocking": False, "summary": "ok"}
+        raise AssertionError(f"Unexpected target: {target}")
+
+    result = asyncio.run(
+        run_coding_loop(
+            issue=issue,
+            dag_state=dag_state,
+            call_fn=call_fn,
+            node_id="swe-planner",
+            config=config,
+        )
+    )
+
+    assert result.outcome == IssueOutcome.FAILED_UNRECOVERABLE
+    assert result.files_changed == []
+    assert reviewer_called is False
+    assert result.iteration_history[0]["path"] == "pre-review-change-gate"
+
+
+def test_git_observed_change_overrides_empty_coder_file_list(tmp_path: Path) -> None:
+    _init_git_repo(tmp_path)
+    dag_state = _make_dag_state(tmp_path, build_id="observed1")
+    config = ExecutionConfig(max_coding_iterations=1)
+    issue = {
+        "name": "create-observed",
+        "files_to_create": ["observed.txt"],
+        "integration_branch": "integration",
+    }
+
+    async def call_fn(target: str, **kwargs):
+        if target.endswith(".run_coder"):
+            (tmp_path / "observed.txt").write_text("written\n")
+            return {"complete": True, "files_changed": [], "summary": "done"}
+        if target.endswith(".run_code_reviewer"):
+            return {
+                "approved": True,
+                "blocking": False,
+                "summary": "verified",
+                "debt_items": [],
+            }
+        raise AssertionError(f"Unexpected target: {target}")
+
+    result = asyncio.run(
+        run_coding_loop(
+            issue=issue,
+            dag_state=dag_state,
+            call_fn=call_fn,
+            node_id="swe-planner",
+            config=config,
+        )
+    )
+
+    assert result.outcome == IssueOutcome.COMPLETED
+    assert result.files_changed == ["observed.txt"]
