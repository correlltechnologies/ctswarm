diff --git a/swe_af/reasoners/pipeline.py b/swe_af/reasoners/pipeline.py
--- a/swe_af/reasoners/pipeline.py
+++ b/swe_af/reasoners/pipeline.py
@@ -50,6 +50,91 @@ def _ensure_paths(base: str) -> dict[str, str]:
     return paths
 
 
+def _ensure_prd_artifact(prd: PRD, prd_path: str) -> bool:
+    """Persist the structured PRD when a harness omits its markdown artifact.
+
+    The parsed schema is sufficient for the next in-memory call, but issue
+    artifacts and acceptance review cite ``prd.md`` as their source of truth.
+    Treat a missing or criterion-dropping document as incomplete and recover it
+    deterministically from the validated schema.
+    """
+    path = Path(prd_path)
+    content = path.read_text(encoding="utf-8") if path.is_file() else ""
+    required = [*prd.must_have, *prd.acceptance_criteria]
+    complete = all(item in content for item in required)
+    if complete:
+        return False
+
+    def bullets(values: list[str], *, checkboxes: bool = False) -> str:
+        prefix = "- [ ] " if checkboxes else "- "
+        return "\n".join(f"{prefix}{value}" for value in values) or "- None"
+
+    path.parent.mkdir(parents=True, exist_ok=True)
+    if len(content.strip()) >= 1_000 and "PRD" in content and "Acceptance" in content:
+        missing_must_have = [item for item in prd.must_have if item not in content]
+        missing_acceptance = [
+            item for item in prd.acceptance_criteria if item not in content
+        ]
+        appendix = f"""
+
+## Structured Contract Appendix
+
+The following validated schema items are binding in addition to the authored
+requirements above. This appendix is added deterministically when the harness's
+structured summary uses wording that does not occur verbatim in the document.
+
+### Must Have
+
+{bullets(missing_must_have)}
+
+### Acceptance Criteria
+
+{bullets(missing_acceptance, checkboxes=True)}
+"""
+        path.write_text(content.rstrip() + appendix, encoding="utf-8")
+        return True
+
+    path.write_text(
+        f"""# Product Requirements Document
+
+## Validated Description
+
+{prd.validated_description.strip()}
+
+## Must Have
+
+{bullets(prd.must_have)}
+
+## Acceptance Criteria
+
+{bullets(prd.acceptance_criteria, checkboxes=True)}
+
+## Nice to Have
+
+{bullets(prd.nice_to_have)}
+
+## Out of Scope
+
+{bullets(prd.out_of_scope)}
+
+## Assumptions
+
+{bullets(prd.assumptions)}
+
+## Risks
+
+{bullets(prd.risks)}
+
+## Completion Contract
+
+- Every must-have is binding and must map to implementation and evidence.
+- Missing evidence, placeholders, or unreachable behavior are blocking failures.
+""",
+        encoding="utf-8",
+    )
+    return True
+
+
