+def test_missing_prd_artifact_is_recovered_from_validated_schema(
+    tmp_path: Path,
+) -> None:
+    prd = PRD(
+        validated_description="Deliver a complete town-to-guardian adventure.",
+        must_have=["Clinic healing is reusable", "Every move has detail data"],
+        acceptance_criteria=[
+            "The full world loop passes deterministically",
+            "Portrait browser evidence has no overflow",
+        ],
+        nice_to_have=["Ambient decoration variants"],
+        out_of_scope=["Online multiplayer"],
+        assumptions=["The existing Canvas runtime remains dependency-free"],
+        risks=["Route changes can make the shrine unreachable"],
+    )
+    path = tmp_path / "plan" / "prd.md"
+
+    assert _ensure_prd_artifact(prd, str(path))
+    content = path.read_text(encoding="utf-8")
+    assert "## Must Have" in content
+    assert "Clinic healing is reusable" in content
+    assert "The full world loop passes deterministically" in content
+    assert "Online multiplayer" in content
+    assert not _ensure_prd_artifact(prd, str(path))
+
+
+def test_authored_prd_is_augmented_without_replacing_its_detail(
+    tmp_path: Path,
+) -> None:
+    prd = PRD(
+        validated_description="Deliver the adventure.",
+        must_have=["Clinic healing is reusable"],
+        acceptance_criteria=["The complete loop passes"],
+        nice_to_have=[],
+        out_of_scope=[],
+    )
+    path = tmp_path / "plan" / "prd.md"
+    path.parent.mkdir(parents=True)
+    authored_detail = "Distinct authored issue PW-012 integration detail."
+    path.write_text(
+        "# Prism Wilds PRD\n\n## Acceptance Gates\n\n"
+        + authored_detail
+        + "\n"
+        + ("Detailed executable requirement.\n" * 50),
+        encoding="utf-8",
+    )
+
+    assert _ensure_prd_artifact(prd, str(path))
+    content = path.read_text(encoding="utf-8")
+    assert authored_detail in content
+    assert "## Structured Contract Appendix" in content
+    assert "Clinic healing is reusable" in content
+    assert "The complete loop passes" in content
+    assert not _ensure_prd_artifact(prd, str(path))
+
+
