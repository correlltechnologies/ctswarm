+def test_committed_change_uses_dag_integration_branch_fallback(tmp_path: Path) -> None:
+    _init_git_repo(tmp_path)
+    subprocess.run(
+        ["git", "checkout", "-q", "-b", "issue/committed-change"],
+        cwd=tmp_path,
+        check=True,
+    )
+    dag_state = _make_dag_state(tmp_path, build_id="committed1")
+    dag_state.git_integration_branch = "integration"
+    config = ExecutionConfig(max_coding_iterations=1)
+    issue = {
+        "name": "create-committed",
+        "files_to_create": ["committed.txt"],
+    }
+    reviewer_called = False
+
+    async def call_fn(target: str, **kwargs):
+        nonlocal reviewer_called
+        if target.endswith(".run_coder"):
+            (tmp_path / "committed.txt").write_text("written\n")
+            subprocess.run(["git", "add", "committed.txt"], cwd=tmp_path, check=True)
+            subprocess.run(
+                ["git", "commit", "-q", "-m", "add committed file"],
+                cwd=tmp_path,
+                check=True,
+            )
+            return {"complete": True, "files_changed": [], "summary": "done"}
+        if target.endswith(".run_code_reviewer"):
+            reviewer_called = True
+            return {
+                "approved": True,
+                "blocking": False,
+                "summary": "verified",
+                "debt_items": [],
+            }
+        raise AssertionError(f"Unexpected target: {target}")
+
+    result = asyncio.run(
+        run_coding_loop(
+            issue=issue,
+            dag_state=dag_state,
+            call_fn=call_fn,
+            node_id="swe-planner",
+            config=config,
+        )
+    )
+
+    assert result.outcome == IssueOutcome.COMPLETED
+    assert result.files_changed == ["committed.txt"]
+    assert reviewer_called is True
+
+
+def test_reviewer_exception_blocks_default_path(tmp_path: Path) -> None:
+    dag_state = _make_dag_state(tmp_path, build_id="reviewfail1")
+    config = ExecutionConfig(max_coding_iterations=1)
+    issue = {"name": "review-must-run"}
+
+    async def call_fn(target: str, **kwargs):
+        if target.endswith(".run_coder"):
+            return {"complete": True, "files_changed": [], "summary": "done"}
+        if target.endswith(".run_code_reviewer"):
+            raise RuntimeError("review service unavailable")
+        raise AssertionError(f"Unexpected target: {target}")
+
+    result = asyncio.run(
+        run_coding_loop(
+            issue=issue,
+            dag_state=dag_state,
+            call_fn=call_fn,
+            node_id="swe-planner",
+            config=config,
+        )
+    )
+
+    assert result.outcome == IssueOutcome.FAILED_UNRECOVERABLE
+    assert "Review unavailable" in result.error_message
+    assert result.iteration_history[0]["review_approved"] is False
+    assert result.iteration_history[0]["review_blocking"] is True
+
+
