+def _consolidate_architecture_artifacts(architecture_path: str) -> list[str]:
+    """Merge architect spill files into the canonical architecture document.
+
+    Long architecture turns can exceed a single harness write and produce
+    ``architecture_continuation*.md`` files. Downstream reviewers and writers
+    intentionally consume ``architecture.md`` as the single source of truth,
+    so leaving those continuations separate silently drops requirements from
+    review. Consolidate them in lexical order and remove the now-redundant
+    generated fragments. The operation is idempotent.
+    """
+    canonical = Path(architecture_path)
+    continuations = sorted(
+        canonical.parent.glob("architecture_continuation*.md")
+    )
+    if not continuations:
+        return []
+
+    canonical_text = (
+        canonical.read_text(encoding="utf-8") if canonical.exists() else ""
+    )
+    merged: list[str] = []
+    for continuation in continuations:
+        continuation_text = continuation.read_text(encoding="utf-8").strip()
+        if continuation_text and continuation_text not in canonical_text:
+            marker = f"<!-- Consolidated from {continuation.name} -->"
+            canonical_text = (
+                f"{canonical_text.rstrip()}\n\n{marker}\n\n"
+                f"{continuation_text}\n"
+            )
+            merged.append(continuation.name)
+        continuation.unlink()
+
+    canonical.write_text(canonical_text, encoding="utf-8")
+    return merged
+
+
+def _recover_architecture_from_document(
+    architecture_path: str,
+) -> Architecture | None:
+    """Recover the transport schema from a substantial canonical document.
+
+    The canonical markdown is the reviewed source of truth. Some long harness
+    turns successfully write that document but omit the small structured
+    sidecar, leaving ``result.parsed`` empty. Recover only enough metadata to
+    route the document to the sprint planner; the tech lead still reviews the
+    complete markdown and remains the quality gate.
+    """
+    path = Path(architecture_path)
+    if not path.exists():
+        return None
+    content = path.read_text(encoding="utf-8").strip()
+    if len(content) < 2000 or "##" not in content:
+        return None
+
+    component_block_match = re.search(
+        r"^##\s+\d*\.?\s*Component Architecture\s*$"
+        r"(?P<body>.*?)(?=^##\s+\S|\Z)",
+        content,
+        flags=re.MULTILINE | re.DOTALL | re.IGNORECASE,
+    )
+    component_block = (
+        component_block_match.group("body")
+        if component_block_match
+        else content
+    )
+    component_matches = list(
+        re.finditer(
+            r"^###\s+(?:\d+(?:\.\d+)*\s+)?(?P<name>.+?)\s*$",
+            component_block,
+            flags=re.MULTILINE,
+        )
+    )
+    components = []
+    for index, match in enumerate(component_matches[:32]):
+        name = match.group("name").strip()
+        if name.lower().startswith(("decision:", "example ")):
+            continue
+        end = (
+            component_matches[index + 1].start()
+            if index + 1 < len(component_matches)
+            else len(component_block)
+        )
+        section = component_block[match.end():end].strip()
+        paragraph = next(
+            (
+                line.strip("* ")
+                for line in section.splitlines()
+                if line.strip() and not line.lstrip().startswith(("#", "```"))
+            ),
+            "Implementation contract is defined in architecture.md.",
+        )
+        components.append(
+            {
+                "name": name,
+                "responsibility": paragraph[:500],
+                "touches_files": [],
+                "depends_on": [],
+            }
+        )
+    if not components:
+        return None
+
+    decisions = []
+    for match in re.finditer(
+        r"^###\s+Decision:\s*(?P<name>.+?)\s*$",
+        content,
+        flags=re.MULTILINE,
+    ):
+        following = content[match.end():]
+        rationale = next(
+            (
+                line.strip("* ")
+                for line in following.splitlines()
+                if line.strip() and not line.lstrip().startswith("#")
+            ),
+            "Rationale is defined in the canonical architecture document.",
+        )
+        decisions.append(
+            {"decision": match.group("name").strip(), "rationale": rationale[:500]}
+        )
+
+    interfaces = list(
+        dict.fromkeys(
+            re.findall(
+                r"\bfunction\s+([A-Za-z_$][\w$]*)\s*\(",
+                content,
+            )
+        )
+    )[:100]
+    summary_match = re.search(
+        r"^##\s+(?:Executive\s+)?Summary\s*$"
+        r"(?P<body>.*?)(?=^##\s+\S|\Z)",
+        content,
+        flags=re.MULTILINE | re.DOTALL | re.IGNORECASE,
+    )
+    summary = (
+        summary_match.group("body").strip()
+        if summary_match
+        else "Canonical architecture recovered from architecture.md."
+    )
+    return Architecture(
+        summary=summary[:2000],
+        components=components,
+        interfaces=interfaces,
+        decisions=decisions,
+        file_changes_overview=(
+            "The canonical file-change plan and exact interfaces are defined in "
+            f"{architecture_path}."
+        ),
+    )
+
+
