+def _validate_planned_issue_set(issues: list[dict]) -> None:
+    """Reject incomplete or ambiguous sprint plans before execution starts."""
+    if not issues:
+        raise RuntimeError("Sprint planner produced no executable issues")
+
+    names: list[str] = []
+    for issue in issues:
+        name = str(issue.get("name") or "").strip()
+        if not re.fullmatch(r"[a-z0-9][a-z0-9-]*", name):
+            raise RuntimeError(f"Sprint planner produced an invalid issue name: {name!r}")
+        names.append(name)
+
+        criteria = issue.get("acceptance_criteria")
+        if not isinstance(criteria, list) or not any(
+            str(criterion).strip() for criterion in criteria
+        ):
+            raise RuntimeError(f"Planned issue {name!r} has no acceptance criteria")
+
+    duplicates = sorted({name for name in names if names.count(name) > 1})
+    if duplicates:
+        raise RuntimeError(
+            "Sprint planner produced duplicate issue names: " + ", ".join(duplicates)
+        )
+
+    known = set(names)
+    for issue in issues:
+        name = str(issue["name"])
+        dependencies = {
+            str(dependency).strip()
+            for dependency in issue.get("depends_on", [])
+            if str(dependency).strip()
+        }
+        unknown = sorted(dependencies - known)
+        if unknown:
+            raise RuntimeError(
+                f"Planned issue {name!r} has unknown dependencies: "
+                + ", ".join(unknown)
+            )
+        if name in dependencies:
+            raise RuntimeError(f"Planned issue {name!r} depends on itself")
+
+
+def _render_issue_artifact(
+    issue: dict,
+    *,
+    prd_path: str,
+    architecture_path: str,
+) -> str:
+    """Render a deterministic issue document from the validated plan stub."""
+    sequence = str(issue.get("sequence_number") or 0).zfill(2)
+    name = str(issue["name"])
+    title = str(issue.get("title") or name.replace("-", " ").title())
+    description = str(issue.get("description") or "").strip()
+    dependencies = [str(item) for item in issue.get("depends_on", [])]
+    provides = [str(item) for item in issue.get("provides", [])]
+    files_create = [str(item) for item in issue.get("files_to_create", [])]
+    files_modify = [str(item) for item in issue.get("files_to_modify", [])]
+    criteria = [
+        str(item).strip()
+        for item in issue.get("acceptance_criteria", [])
+        if str(item).strip()
+    ]
+    testing = str(issue.get("testing_strategy") or "").strip()
+
+    def bullets(values: list[str], empty: str) -> str:
+        return "\n".join(f"- {value}" for value in values) or f"- {empty}"
+
+    files = [f"Create: `{path}`" for path in files_create]
+    files.extend(f"Modify: `{path}`" for path in files_modify)
+    return f"""# issue-{sequence}-{name}: {title}
+
+## Description
+{description}
+
+## Source of Truth
+- PRD: `{prd_path}`
+- Architecture: `{architecture_path}`
+
+## Files
+{bullets(files, "Confirm exact files from the architecture before editing")}
+
+## Dependencies
+{bullets(dependencies, "None")}
+
+## Provides
+{bullets(provides, "The behavior described by this issue")}
+
+## Acceptance Criteria
+{bullets([f"[ ] {criterion}" for criterion in criteria], "No criteria supplied")}
+
+## Testing Strategy
+{testing or "Run the repository's relevant deterministic, integration, and acceptance checks."}
+
+## Completion Contract
+- Implement production behavior, not placeholders, TODOs, log-only paths, or disabled checks.
+- Record the exact commands and evidence proving every acceptance criterion.
+"""
+
+
+def _ensure_issue_artifacts(
+    issues: list[dict],
+    *,
+    issues_dir: str,
+    prd_path: str,
+    architecture_path: str,
+) -> list[str]:
+    """Guarantee one complete issue file for every structured plan entry.
+
+    Issue writers are useful for richer prose, but their success claim is not
+    evidence that a file exists. Missing, empty, or criterion-dropping outputs
+    are deterministically regenerated from the validated sprint-plan schema.
+    """
+    root = Path(issues_dir).resolve()
+    root.mkdir(parents=True, exist_ok=True)
+    recovered: list[str] = []
+
+    for issue in issues:
+        sequence = str(issue.get("sequence_number") or 0).zfill(2)
+        name = str(issue["name"])
+        expected = root / f"issue-{sequence}-{name}.md"
+        content = ""
+        if expected.is_file():
+            content = expected.read_text(encoding="utf-8")
+        criteria = [
+            str(item).strip()
+            for item in issue.get("acceptance_criteria", [])
+            if str(item).strip()
+        ]
+        complete = (
+            len(content.strip()) >= 200
+            and "## Acceptance Criteria" in content
+            and "## Testing Strategy" in content
+            and all(criterion in content for criterion in criteria)
+        )
+        if not complete:
+            expected.write_text(
+                _render_issue_artifact(
+                    issue,
+                    prd_path=prd_path,
+                    architecture_path=architecture_path,
+                ),
+                encoding="utf-8",
+            )
+            recovered.append(name)
+
+    missing = [
+        str(issue["name"])
+        for issue in issues
+        if not (
+            root
+            / f"issue-{str(issue.get('sequence_number') or 0).zfill(2)}-"
+            f"{issue['name']}.md"
+        ).is_file()
+    ]
+    if missing:
+        raise RuntimeError(
+            "Planning artifact recovery failed for issues: " + ", ".join(missing)
+        )
+    return recovered
+
