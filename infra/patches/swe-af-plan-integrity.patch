+"""Planning integrity gates for autonomous builds."""
+
+from pathlib import Path
+
+import pytest
+
+from swe_af.app import _ensure_issue_artifacts, _validate_planned_issue_set
+from swe_af.reasoners.pipeline import (
+    _consolidate_architecture_artifacts,
+    _recover_architecture_from_document,
+)
+
+
+def issue(name: str, sequence: int, *, depends_on: list[str] | None = None) -> dict:
+    return {
+        "name": name,
+        "title": name.replace("-", " ").title(),
+        "description": f"Deliver the complete {name} behavior.",
+        "acceptance_criteria": [f"{name} works through the real user flow"],
+        "depends_on": depends_on or [],
+        "provides": [f"{name} capability"],
+        "files_to_create": [],
+        "files_to_modify": ["src/app.ts"],
+        "testing_strategy": f"Run tests/{name}.test.ts with the repository test runner.",
+        "sequence_number": sequence,
+    }
+
+
+def test_planned_issue_set_rejects_duplicates_and_unknown_dependencies() -> None:
+    with pytest.raises(RuntimeError, match="duplicate issue names"):
+        _validate_planned_issue_set([issue("town", 1), issue("town", 2)])
+
+    with pytest.raises(RuntimeError, match="unknown dependencies"):
+        _validate_planned_issue_set(
+            [issue("clinic", 1, depends_on=["missing-town"])]
+        )
+
+
+def test_planned_issue_set_requires_acceptance_criteria() -> None:
+    planned = issue("inventory", 1)
+    planned["acceptance_criteria"] = []
+
+    with pytest.raises(RuntimeError, match="has no acceptance criteria"):
+        _validate_planned_issue_set([planned])
+
+
+def test_missing_issue_writer_outputs_are_recovered_deterministically(
+    tmp_path: Path,
+) -> None:
+    planned = [issue("town", 1), issue("clinic", 2, depends_on=["town"])]
+    _validate_planned_issue_set(planned)
+
+    recovered = _ensure_issue_artifacts(
+        planned,
+        issues_dir=str(tmp_path / "plan" / "issues"),
+        prd_path=str(tmp_path / "plan" / "prd.md"),
+        architecture_path=str(tmp_path / "plan" / "architecture.md"),
+    )
+
+    assert recovered == ["town", "clinic"]
+    files = sorted((tmp_path / "plan" / "issues").glob("issue-*.md"))
+    assert [path.name for path in files] == [
+        "issue-01-town.md",
+        "issue-02-clinic.md",
+    ]
+    assert "town works through the real user flow" in files[0].read_text()
+    assert "clinic works through the real user flow" in files[1].read_text()
+
+
+def test_incomplete_issue_writer_output_is_replaced(tmp_path: Path) -> None:
+    planned = issue("battle-items", 3)
+    issues_dir = tmp_path / "plan" / "issues"
+    issues_dir.mkdir(parents=True)
+    path = issues_dir / "issue-03-battle-items.md"
+    path.write_text("claimed success", encoding="utf-8")
+
+    recovered = _ensure_issue_artifacts(
+        [planned],
