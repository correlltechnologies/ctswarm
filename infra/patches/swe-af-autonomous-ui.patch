+                    "Browser-facing acceptance must be proven by complete "
+                    "interactive scenarios and retained screenshots."
+                ),
+                "passed": False,
+                "evidence": message,
+                "issue_name": "",
+            }
+        )
+        result.setdefault("suggested_fixes", []).append(message)
+    return result
+
