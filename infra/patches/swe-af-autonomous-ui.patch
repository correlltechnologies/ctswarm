+    base_sha: str,
+) -> dict:
+    """Turn integration and placeholder evidence into blocking criteria."""
+    criteria = verification.setdefault("criteria_results", [])
+    suggested = verification.setdefault("suggested_fixes", [])
+    failures: list[dict] = []
+
+    for result in dag_result.get("integration_test_results", []) or []:
+        if result.get("passed") is True:
+            continue
+        summary = result.get("summary") or "integration tester did not pass"
+        details = result.get("failure_details") or []
+        detail_text = "; ".join(
+            str(item.get("error", item)) if isinstance(item, dict) else str(item)
+            for item in details[:5]
+        )
+        evidence = summary + (f" — {detail_text}" if detail_text else "")
+        failures.append(
+            {
+                "criterion": "Merged cross-feature integration must pass.",
+                "passed": False,
+                "evidence": evidence,
+                "issue_name": "",
+            }
+        )
+
+    placeholders = _added_placeholder_failures(repo_path, base_sha)
+    if placeholders:
+        failures.append(
+            {
+                "criterion": (
+                    "Production paths must not contain newly-added placeholder "
+                    "or deferred feature behavior."
