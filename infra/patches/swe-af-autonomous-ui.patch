+def _added_placeholder_failures(repo_path: str, base_sha: str) -> list[str]:
+    """Find newly-added production placeholders that cannot ship as features."""
+    if not base_sha:
+        return []
+    proc = subprocess.run(
+        ["git", "diff", "--unified=0", f"{base_sha}...HEAD", "--"],
+        cwd=repo_path,
+        capture_output=True,
+        text=True,
+        check=False,
+    )
+    if proc.returncode != 0:
+        return [f"placeholder scan could not read the integrated diff: {proc.stderr.strip()}"]
+
+    failures: list[str] = []
+    current_path = ""
+    for line in proc.stdout.splitlines():
+        if line.startswith("+++ b/"):
+            current_path = line[6:]
+            continue
+        if not line.startswith("+") or line.startswith("+++"):
+            continue
+        lowered_path = current_path.lower()
+        if (
+            Path(current_path).suffix.lower() not in _PRODUCTION_SUFFIXES
+            or "/test" in lowered_path
+            or lowered_path.startswith(("test", "docs/"))
+        ):
+            continue
+        match = _PLACEHOLDER_PATTERN.search(line[1:])
+        if match:
+            failures.append(f"{current_path}: {match.group(0)}")
+    return failures[:20]
+
+
+def _apply_deterministic_acceptance_failures(
+    verification: dict,
+    dag_result: dict,
+    *,
