+"""Regression tests for autonomous browser and integration acceptance gates."""
+
+from __future__ import annotations
+
+import subprocess
+
+from swe_af.app import (
+    _added_placeholder_failures,
+    _apply_deterministic_acceptance_failures,
+)
+from swe_af.prompts.integration_tester import integration_tester_task_prompt
+from swe_af.prompts.verifier import SYSTEM_PROMPT as VERIFIER_SYSTEM_PROMPT
+from swe_af.reasoners.execution_agents import (
+    _enforce_browser_verification,
+    _requires_browser_verification,
+)
+
+
+def test_html_repo_requires_browser_verification(tmp_path) -> None:
+    (tmp_path / "index.html").write_text("<canvas></canvas>")
+
+    assert _requires_browser_verification(str(tmp_path), "small app") is True
+
+
+def test_missing_browser_evidence_forces_failed_verdict(tmp_path) -> None:
+    artifacts = tmp_path / ".artifacts"
+    artifacts.mkdir()
+    result = {
+        "passed": True,
+        "criteria_results": [],
+        "summary": "looks good",
+        "suggested_fixes": [],
+        "browser_evidence": [],
+        "browser_scenarios": [],
+        "browser_console_errors": [],
+    }
+
+    gated = _enforce_browser_verification(
+        result,
+        repo_path=str(tmp_path),
+        artifacts_dir=".artifacts",
+        required=True,
+        integration=False,
+    )
+
+    assert gated["passed"] is False
+    assert gated["criteria_results"][-1]["passed"] is False
+    assert "no browser scenarios" in gated["summary"]
+
+
+def test_real_browser_evidence_preserves_passing_verdict(tmp_path) -> None:
+    artifacts = tmp_path / ".artifacts" / "browser-evidence"
+    artifacts.mkdir(parents=True)
+    screenshot = artifacts / "complete-loop.png"
+    screenshot.write_bytes(b"real image bytes")
+    result = {
+        "passed": True,
+        "criteria_results": [],
+        "summary": "complete loop passed",
+        "suggested_fixes": [],
+        "browser_evidence": [str(screenshot)],
+        "browser_scenarios": [
+            {
+                "name": "complete required loop",
+                "passed": True,
+                "evidence": "starter, encounter, battle, and ending observed",
+            }
+        ],
+        "browser_console_errors": [],
+    }
+
+    gated = _enforce_browser_verification(
+        result,
+        repo_path=str(tmp_path),
+        artifacts_dir=".artifacts",
+        required=True,
+        integration=False,
+    )
+
+    assert gated["passed"] is True
+
+
+def test_failed_integration_becomes_blocking_acceptance_criterion(tmp_path) -> None:
+    verification = {
+        "passed": True,
+        "criteria_results": [],
+        "suggested_fixes": [],
+        "summary": "model approved",
+    }
+    dag_result = {
+        "integration_test_results": [
+            {
+                "passed": False,
+                "summary": "encounters never begin",
+                "failure_details": [
+                    {"error": "phase stayed EXPLORE after forced encounter"}
+                ],
+            }
+        ]
+    }
+
+    gated = _apply_deterministic_acceptance_failures(
+        verification,
+        dag_result,
+        repo_path=str(tmp_path),
+        base_sha="",
+    )
+
+    assert gated["passed"] is False
+    assert gated["criteria_results"][-1]["criterion"].startswith(
+        "Merged cross-feature"
+    )
+    assert "encounters never begin" in gated["criteria_results"][-1]["evidence"]
+
+
+def test_new_production_placeholder_is_blocking(tmp_path) -> None:
+    subprocess.run(["git", "init"], cwd=tmp_path, check=True, capture_output=True)
+    subprocess.run(
+        ["git", "config", "user.email", "test@example.com"],
+        cwd=tmp_path,
+        check=True,
+    )
+    subprocess.run(
+        ["git", "config", "user.name", "Test"],
+        cwd=tmp_path,
+        check=True,
+    )
+    (tmp_path / "index.html").write_text("<button>Start</button>")
+    subprocess.run(["git", "add", "index.html"], cwd=tmp_path, check=True)
+    subprocess.run(["git", "commit", "-m", "base"], cwd=tmp_path, check=True)
+    base = subprocess.run(
+        ["git", "rev-parse", "HEAD"],
+        cwd=tmp_path,
+        check=True,
+        capture_output=True,
+        text=True,
+    ).stdout.strip()
+    (tmp_path / "index.html").write_text(
+        "<button>Start</button><script>console.log('Battle not yet available')</script>"
+    )
+    subprocess.run(["git", "add", "index.html"], cwd=tmp_path, check=True)
+    subprocess.run(["git", "commit", "-m", "feature"], cwd=tmp_path, check=True)
+
+    assert _added_placeholder_failures(str(tmp_path), base) == [
+        "index.html: not yet available"
+    ]
+
+
+def test_ui_prompts_require_agent_browser_and_artifact_evidence() -> None:
+    prompt = integration_tester_task_prompt(
+        repo_path="/repo",
+        integration_branch="feature/test",
+        merged_branches=[],
+        prd_summary="A browser game",
+        architecture_summary="One HTML file",
+        conflict_resolutions=[],
+        artifacts_dir="/repo/.artifacts",
+    )
+
+    assert "agent-browser" in prompt
+    assert "/repo/.artifacts" in prompt
+    assert "every required user flow" in prompt
+    assert "agent-browser" in VERIFIER_SYSTEM_PROMPT
