+    message = "Browser acceptance failed: " + "; ".join(failures)
+    result["passed"] = False
+    result["summary"] = f"{result.get('summary', '').strip()} {message}".strip()
+    if integration:
+        result.setdefault("failure_details", []).append(
+            {
+                "test_name": "mandatory_browser_acceptance",
+                "error": message,
+                "file": "",
+            }
+        )
+        result["tests_failed"] = max(1, int(result.get("tests_failed") or 0))
+        result["tests_run"] = max(
+            int(result.get("tests_run") or 0),
+            int(result.get("tests_passed") or 0) + result["tests_failed"],
+        )
+    else:
+        result.setdefault("criteria_results", []).append(
+            {
