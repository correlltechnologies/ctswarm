     )
 
 
+def _ensure_architecture_artifact(
+    architecture: Architecture,
+    architecture_path: str,
+) -> bool:
+    """Persist the validated architecture schema as the canonical document.
+
+    Harnesses are asked to write a richer document, but a valid structured
+    result must never advance to tech-lead review while ``architecture.md`` is
+    missing or drops components. The recovered document remains reviewable and
+    preserves every structured interface, decision, dependency, and file note.
+    """
+    path = Path(architecture_path)
+    content = path.read_text(encoding="utf-8") if path.is_file() else ""
+    required = [
+        architecture.summary,
+        architecture.file_changes_overview,
+        *(component.name for component in architecture.components),
+        *(component.responsibility for component in architecture.components),
+        *architecture.interfaces,
+        *(decision.decision for decision in architecture.decisions),
+        *(decision.rationale for decision in architecture.decisions),
+    ]
+    generated = "<!-- ctswarm:structured-architecture -->" in content
+    complete = (
+        (generated or len(content.strip()) >= 1000)
+        and "## Component Architecture" in content
+        and "## Interfaces" in content
+        and "## Decisions" in content
+        and all(item in content for item in required if item.strip())
+    )
+    if complete:
+        return False
+
+    component_sections = []
+    for index, component in enumerate(architecture.components, start=1):
+        files = (
+            "\n".join(f"- `{item}`" for item in component.touches_files)
+            or "- None declared"
+        )
+        dependencies = (
+            "\n".join(f"- {item}" for item in component.depends_on)
+            or "- None"
+        )
+        component_sections.append(
+            f"""### {index}. {component.name}
+
+{component.responsibility}
+
+**Touches files**
+{files}
+
+**Depends on**
+{dependencies}
+"""
+        )
+    interfaces = (
+        "\n".join(f"- `{item}`" for item in architecture.interfaces)
+        or "- None declared"
+    )
+    decisions = "\n\n".join(
+        f"### Decision: {item.decision}\n\n{item.rationale}"
+        for item in architecture.decisions
+    ) or "No explicit decisions declared."
+
+    path.parent.mkdir(parents=True, exist_ok=True)
+    path.write_text(
+        f"""<!-- ctswarm:structured-architecture -->
+
+# Technical Architecture
+
+## Executive Summary
+
+{architecture.summary}
+
+## Component Architecture
+
+{''.join(component_sections)}
+## Interfaces
+
+{interfaces}
+
+## Decisions
+
+{decisions}
+
+## File Changes Overview
+
+{architecture.file_changes_overview}
+
+## Review Contract
+
+- The tech lead must reject missing PRD coverage or non-executable evidence.
+- Canonical architecture content governs implementation, not a sidecar success claim.
+""",
+        encoding="utf-8",
+    )
+    return True
+
+
