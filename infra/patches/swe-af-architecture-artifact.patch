+def test_missing_architecture_document_is_recovered_from_schema(
+    tmp_path: Path,
+) -> None:
+    architecture = Architecture(
+        summary="Deliver the complete deterministic adventure architecture.",
+        components=[
+            {
+                "name": "Screenshot Automation",
+                "responsibility": "Capture every required browser state.",
+                "touches_files": ["scripts/capture.mjs"],
+                "depends_on": ["Deterministic Hooks"],
+            },
+            {
+                "name": "World Continuity",
+                "responsibility": "Preserve the town-to-guardian lifecycle.",
+                "touches_files": ["src/game.js"],
+                "depends_on": [],
+            },
+        ],
+        interfaces=["captureRequiredScenes()", "resetAtClinic()"],
+        decisions=[
+            {
+                "decision": "Keep Canvas dependency-free",
+                "rationale": "Preserves the verified runtime boundary.",
+            }
+        ],
+        file_changes_overview="Update game state, tests, and evidence scripts.",
+    )
+    path = tmp_path / "plan" / "architecture.md"
+
+    assert _ensure_architecture_artifact(architecture, str(path))
+    content = path.read_text(encoding="utf-8")
+    assert "Screenshot Automation" in content
+    assert "World Continuity" in content
+    assert "captureRequiredScenes()" in content
+    assert "Keep Canvas dependency-free" in content
+    assert not _ensure_architecture_artifact(architecture, str(path))
