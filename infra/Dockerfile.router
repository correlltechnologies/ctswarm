# ctswarm router and approval service.
#
# Deliberately minimal: this image holds no model weights and no repository
# checkouts. It proxies inference and mediates approvals, so keeping its
# filesystem boring limits what a compromised agent could reach through it.

FROM python:3.12-slim

# curl is used by the compose healthcheck fallback and by bootstrap diagnostics.
RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install dependencies as their own layer so source edits do not invalidate the
# dependency cache on every rebuild.
COPY pyproject.toml ./
RUN pip install --no-cache-dir \
        "fastapi>=0.115" \
        "uvicorn[standard]>=0.30" \
        "httpx>=0.27" \
        "pydantic>=2.7" \
        "typer>=0.12" \
        "rich>=13.7"

COPY ctswarm ./ctswarm

# Writable state lives on a volume, never in the image layer, so a container
# restart preserves the ledger. Probe 5 restarts the stack mid-build and asserts
# that recorded state survived.
RUN mkdir -p /state
ENV CTSWARM_DB=/state/ctswarm.db \
    CTSWARM_ROUTING=/bench-results/routing.json \
    PYTHONUNBUFFERED=1

# Run as a non-root user. The router needs no privileged access at all.
RUN useradd --create-home --uid 10001 ctswarm \
    && chown -R ctswarm:ctswarm /app /state
USER ctswarm

EXPOSE 8090
CMD ["uvicorn", "ctswarm.router.server:app", "--host", "0.0.0.0", "--port", "8090"]
