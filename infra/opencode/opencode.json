{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ctswarm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ctswarm router",
      "options": {
        "baseURL": "http://ctswarm-router:8090/v1",
        "apiKey": "not-required-loopback"
      },
      "models": {
        "high": {
          "name": "ctswarm high tier (planning)",
          "tool_call": true,
          "limit": {
            "context": 200000,
            "output": 32768
          }
        },
        "med": {
          "name": "ctswarm med tier (coding, review, QA)",
          "tool_call": true,
          "limit": {
            "context": 200000,
            "output": 32768
          }
        },
        "low": {
          "name": "ctswarm low tier (mechanical)",
          "tool_call": true,
          "limit": {
            "context": 131072,
            "output": 8192
          }
        }
      }
    }
  }
}
