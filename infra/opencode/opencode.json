{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ctswarm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "ctswarm router",
      "options": {
        "baseURL": "http://ctswarm-router:8090/v1",
        "apiKey": "not-required-loopback"
      },
      "models": {
        "high": {
          "name": "ctswarm high tier (planning)",
